<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="640"
        Width="320" SizeToContent="Height"
        x:Class="UbuntuEdgeLight.ControlWindow"
        Title="Controls"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector="Button.preset">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.preset:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#44FFFFFF" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#AAFFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="LightGray" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Border Background="#DD1A1A1A" CornerRadius="14" Padding="16" PointerPressed="OnPointerPressed"
            BorderBrush="#22FFFFFF" BorderThickness="1">
        <StackPanel Orientation="Vertical" Spacing="12">
            <!-- Header -->
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Studio Light" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Background="Transparent" Foreground="White" BorderThickness="0"/>
            </Grid>

            <!-- Presets -->
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="PRESETS"/>
                <WrapPanel Orientation="Horizontal">
                    <Button Classes="preset" Content="Soft Key"     Click="Preset_Click" Tag="SoftKey"    Margin="0,0,6,6"/>
                    <Button Classes="preset" Content="Warm Studio"  Click="Preset_Click" Tag="WarmStudio" Margin="0,0,6,6"/>
                    <Button Classes="preset" Content="Daylight"     Click="Preset_Click" Tag="Daylight"   Margin="0,0,6,6"/>
                    <Button Classes="preset" Content="Cool"         Click="Preset_Click" Tag="Cool"       Margin="0,0,6,6"/>
                    <Button Classes="preset" Content="Candle"       Click="Preset_Click" Tag="Candle"     Margin="0,0,6,6"/>
                </WrapPanel>
            </StackPanel>

            <!-- Studio flood toggle + spotlight -->
            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                <CheckBox Name="ChkFlood" Content="Studio flood (illuminate)" IsCheckedChanged="ChkFlood_Changed"/>
                <Button Grid.Column="1" Name="BtnSpotlight" Content="💡 Spotlight" Classes="preset" Click="Spotlight_Click"/>
            </Grid>

            <Separator Background="#33FFFFFF" Height="1" />

            <!-- Brightness -->
            <StackPanel>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Brightness 🔆" Foreground="LightGray" FontSize="12"/>
                    <TextBlock Text="{Binding ElementName=SliderBrightness, Path=Value, StringFormat={}{0:0.0}}" Foreground="Gray" FontSize="12"/>
                </Grid>
                <Slider Name="SliderBrightness" Minimum="0.2" Maximum="1.0" ValueChanged="SliderBrightness_ValueChanged" />
            </StackPanel>

            <!-- Color Temp -->
            <StackPanel>
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <TextBlock Text="❄️" Foreground="LightBlue"/>
                    <TextBlock Grid.Column="2" Text="🔥" Foreground="Orange"/>
                </Grid>
                <Slider Name="SliderColor" Minimum="0.0" Maximum="1.0" ValueChanged="SliderColor_ValueChanged" />
            </StackPanel>

            <!-- Spread (studio flood width) -->
            <StackPanel Name="SpreadPanel">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Light Spread" Foreground="LightGray" FontSize="12"/>
                    <TextBlock Text="{Binding ElementName=SliderSpread, Path=Value, StringFormat={}{0:0}}" Foreground="Gray" FontSize="12"/>
                </Grid>
                <Slider Name="SliderSpread" Minimum="20" Maximum="600" ValueChanged="SliderSpread_ValueChanged" />
            </StackPanel>

            <!-- Thickness (thin border width) -->
            <StackPanel Name="ThicknessPanel">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Border Thickness" Foreground="LightGray" FontSize="12"/>
                    <TextBlock Text="{Binding ElementName=SliderThickness, Path=Value, StringFormat={}{0:0}}" Foreground="Gray" FontSize="12"/>
                </Grid>
                <Slider Name="SliderThickness" Minimum="1" Maximum="50" ValueChanged="SliderThickness_ValueChanged" />
            </StackPanel>

            <!-- Margin (Distance) -->
            <StackPanel>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Distance from Edge" Foreground="LightGray" FontSize="12"/>
                    <TextBlock Text="{Binding ElementName=SliderMargin, Path=Value, StringFormat={}{0:0}}" Foreground="Gray" FontSize="12"/>
                </Grid>
                <Slider Name="SliderMargin" Minimum="0" Maximum="100" ValueChanged="SliderMargin_ValueChanged" />
            </StackPanel>

            <!-- Roundness -->
            <StackPanel Name="RadiusPanel">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Corner Roundness" Foreground="LightGray" FontSize="12"/>
                    <TextBlock Text="{Binding ElementName=SliderRadius, Path=Value, StringFormat={}{0:0}}" Foreground="Gray" FontSize="12"/>
                </Grid>
                <Slider Name="SliderRadius" Minimum="0" Maximum="100" ValueChanged="SliderRadius_ValueChanged" />
            </StackPanel>

            <Separator Background="#33FFFFFF" Height="1" />

            <!-- Adaptive -->
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="ADAPTIVE"/>
                <CheckBox Name="ChkAutoDayNight" Content="Auto day / night" IsCheckedChanged="ChkAutoDayNight_Changed"/>
                <CheckBox Name="ChkAmbient" Content="Match screen ambient" IsCheckedChanged="ChkAmbient_Changed"/>
            </StackPanel>

            <Separator Background="#33FFFFFF" Height="1" />

            <!-- Quit -->
            <Button Content="Quit Screen Edge Light" Click="Exit_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#33FF5555" Foreground="White" BorderThickness="0"
                    CornerRadius="8" Padding="10,8"/>
        </StackPanel>
    </Border>
</Window>
