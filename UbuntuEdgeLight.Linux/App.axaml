<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UbuntuEdgeLight.App"
             Name="Screen Edge Light"
             RequestedThemeVariant="Dark">

    <!-- No tray icon: under GNOME + snap confinement the tray menu (dbusmenu) is blocked
         by AppArmor, so the icon would show up with a menu that never opens. The floating
         ⚙ button and relaunching the app are the ways back to the control panel. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
